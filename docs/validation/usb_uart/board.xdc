# Generated by Ramp Studio. Verify electrical compatibility against the board schematic.
# Core clock is generated by Clocking Wizard; input clock remains the physical oscillator frequency.
create_clock -name sys_clk -period 20.000000 [get_ports {sys_clk}]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property CONFIG_MODE SPIx1 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 1 [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 16 [current_design]
set_property BITSTREAM.CONFIG.SPI_FALL_EDGE Yes [current_design]

# Interface: Reference clock
set_property -dict {PACKAGE_PIN R4 IOSTANDARD LVCMOS33} [get_ports {sys_clk}]

# Interface: UART and auxiliary outputs
set_property -dict {PACKAGE_PIN U5 IOSTANDARD LVCMOS33} [get_ports {uart_rx}]
set_property -dict {PACKAGE_PIN T6 IOSTANDARD LVCMOS33} [get_ports {uart_tx}]
set_property -dict {PACKAGE_PIN F15 IOSTANDARD LVCMOS33} [get_ports {gnd0}]
set_property -dict {PACKAGE_PIN F16 IOSTANDARD LVCMOS33} [get_ports {gnd1}]

# Interface: External triggers
set_property -dict {PACKAGE_PIN F13 IOSTANDARD LVCMOS33} [get_ports {trigger_in[0]}]
set_property -dict {PACKAGE_PIN F14 IOSTANDARD LVCMOS33} [get_ports {trigger_in[1]}]

# Interface: DAC 1
set_property -dict {PACKAGE_PIN Y8 IOSTANDARD LVCMOS33} [get_ports {dac_clk[0]}]
set_property -dict {PACKAGE_PIN V9 IOSTANDARD LVCMOS33} [get_ports {dac_data[0]}]
set_property -dict {PACKAGE_PIN W9 IOSTANDARD LVCMOS33} [get_ports {dac_data[1]}]
set_property -dict {PACKAGE_PIN Y9 IOSTANDARD LVCMOS33} [get_ports {dac_data[2]}]
set_property -dict {PACKAGE_PIN V8 IOSTANDARD LVCMOS33} [get_ports {dac_data[3]}]
set_property -dict {PACKAGE_PIN U7 IOSTANDARD LVCMOS33} [get_ports {dac_data[4]}]
set_property -dict {PACKAGE_PIN AB7 IOSTANDARD LVCMOS33} [get_ports {dac_data[5]}]
set_property -dict {PACKAGE_PIN V7 IOSTANDARD LVCMOS33} [get_ports {dac_data[6]}]
set_property -dict {PACKAGE_PIN AB6 IOSTANDARD LVCMOS33} [get_ports {dac_data[7]}]
set_property -dict {PACKAGE_PIN AB8 IOSTANDARD LVCMOS33} [get_ports {dac_data[8]}]
set_property -dict {PACKAGE_PIN AA8 IOSTANDARD LVCMOS33} [get_ports {dac_data[9]}]

# Interface: DAC 2
set_property -dict {PACKAGE_PIN R14 IOSTANDARD LVCMOS33} [get_ports {dac_clk[1]}]
set_property -dict {PACKAGE_PIN U18 IOSTANDARD LVCMOS33} [get_ports {dac_data[10]}]
set_property -dict {PACKAGE_PIN U17 IOSTANDARD LVCMOS33} [get_ports {dac_data[11]}]
set_property -dict {PACKAGE_PIN V19 IOSTANDARD LVCMOS33} [get_ports {dac_data[12]}]
set_property -dict {PACKAGE_PIN T18 IOSTANDARD LVCMOS33} [get_ports {dac_data[13]}]
set_property -dict {PACKAGE_PIN V20 IOSTANDARD LVCMOS33} [get_ports {dac_data[14]}]
set_property -dict {PACKAGE_PIN R18 IOSTANDARD LVCMOS33} [get_ports {dac_data[15]}]
set_property -dict {PACKAGE_PIN N17 IOSTANDARD LVCMOS33} [get_ports {dac_data[16]}]
set_property -dict {PACKAGE_PIN P17 IOSTANDARD LVCMOS33} [get_ports {dac_data[17]}]
set_property -dict {PACKAGE_PIN R16 IOSTANDARD LVCMOS33} [get_ports {dac_data[18]}]
set_property -dict {PACKAGE_PIN P15 IOSTANDARD LVCMOS33} [get_ports {dac_data[19]}]

# Interface: DAC 3
set_property -dict {PACKAGE_PIN E19 IOSTANDARD LVCMOS33} [get_ports {dac_clk[2]}]
set_property -dict {PACKAGE_PIN N22 IOSTANDARD LVCMOS33} [get_ports {dac_data[20]}]
set_property -dict {PACKAGE_PIN M22 IOSTANDARD LVCMOS33} [get_ports {dac_data[21]}]
set_property -dict {PACKAGE_PIN M21 IOSTANDARD LVCMOS33} [get_ports {dac_data[22]}]
set_property -dict {PACKAGE_PIN L21 IOSTANDARD LVCMOS33} [get_ports {dac_data[23]}]
set_property -dict {PACKAGE_PIN K22 IOSTANDARD LVCMOS33} [get_ports {dac_data[24]}]
set_property -dict {PACKAGE_PIN K21 IOSTANDARD LVCMOS33} [get_ports {dac_data[25]}]
set_property -dict {PACKAGE_PIN J22 IOSTANDARD LVCMOS33} [get_ports {dac_data[26]}]
set_property -dict {PACKAGE_PIN H22 IOSTANDARD LVCMOS33} [get_ports {dac_data[27]}]
set_property -dict {PACKAGE_PIN G22 IOSTANDARD LVCMOS33} [get_ports {dac_data[28]}]
set_property -dict {PACKAGE_PIN G21 IOSTANDARD LVCMOS33} [get_ports {dac_data[29]}]

# Interface: DAC 4
set_property -dict {PACKAGE_PIN F21 IOSTANDARD LVCMOS33} [get_ports {dac_clk[3]}]
set_property -dict {PACKAGE_PIN N19 IOSTANDARD LVCMOS33} [get_ports {dac_data[30]}]
set_property -dict {PACKAGE_PIN N18 IOSTANDARD LVCMOS33} [get_ports {dac_data[31]}]
set_property -dict {PACKAGE_PIN M20 IOSTANDARD LVCMOS33} [get_ports {dac_data[32]}]
set_property -dict {PACKAGE_PIN N20 IOSTANDARD LVCMOS33} [get_ports {dac_data[33]}]
set_property -dict {PACKAGE_PIN J21 IOSTANDARD LVCMOS33} [get_ports {dac_data[34]}]
set_property -dict {PACKAGE_PIN J20 IOSTANDARD LVCMOS33} [get_ports {dac_data[35]}]
set_property -dict {PACKAGE_PIN G20 IOSTANDARD LVCMOS33} [get_ports {dac_data[36]}]
set_property -dict {PACKAGE_PIN H20 IOSTANDARD LVCMOS33} [get_ports {dac_data[37]}]
set_property -dict {PACKAGE_PIN L18 IOSTANDARD LVCMOS33} [get_ports {dac_data[38]}]
set_property -dict {PACKAGE_PIN M18 IOSTANDARD LVCMOS33} [get_ports {dac_data[39]}]

# Interface: FT232H USB FIFO (15 pins; independent IO standard)
set_property -dict {PACKAGE_PIN Y4 IOSTANDARD LVCMOS33} [get_ports {usb_clk}]
set_property -dict {PACKAGE_PIN AB5 IOSTANDARD LVCMOS33} [get_ports {usb_data[0]}]
set_property -dict {PACKAGE_PIN AA4 IOSTANDARD LVCMOS33} [get_ports {usb_data[1]}]
set_property -dict {PACKAGE_PIN AB3 IOSTANDARD LVCMOS33} [get_ports {usb_data[2]}]
set_property -dict {PACKAGE_PIN AA3 IOSTANDARD LVCMOS33} [get_ports {usb_data[3]}]
set_property -dict {PACKAGE_PIN AB2 IOSTANDARD LVCMOS33} [get_ports {usb_data[4]}]
set_property -dict {PACKAGE_PIN AB1 IOSTANDARD LVCMOS33} [get_ports {usb_data[5]}]
set_property -dict {PACKAGE_PIN AA1 IOSTANDARD LVCMOS33} [get_ports {usb_data[6]}]
set_property -dict {PACKAGE_PIN Y1 IOSTANDARD LVCMOS33} [get_ports {usb_data[7]}]
set_property -dict {PACKAGE_PIN W1 IOSTANDARD LVCMOS33} [get_ports {usb_rxf_n}]
set_property -dict {PACKAGE_PIN AA5 IOSTANDARD LVCMOS33} [get_ports {usb_txe_n}]
set_property -dict {PACKAGE_PIN V4 IOSTANDARD LVCMOS33} [get_ports {usb_rd_n}]
set_property -dict {PACKAGE_PIN Y3 IOSTANDARD LVCMOS33} [get_ports {usb_wr_n}]
set_property -dict {PACKAGE_PIN U3 IOSTANDARD LVCMOS33} [get_ports {usb_oe_n}]
set_property -dict {PACKAGE_PIN V3 IOSTANDARD LVCMOS33} [get_ports {usb_siwu_n}]

# Interface: FT232H USB FIFO timing (60 MHz)
# FT232H synchronous FIFO, DS_FT232H table 4.1; include PCB skew in configured delays.
create_clock -name usb_clk -period 16.666667 [get_ports {usb_clk}]
# Fast output transitions are required for the 60 MHz FIFO bus; timing bounds are unchanged.
set_property SLEW FAST [get_ports {usb_data[*] usb_rd_n usb_wr_n usb_oe_n}]
set_input_delay -clock [get_clocks usb_clk] -min 0.000000 [get_ports {usb_data[*] usb_rxf_n usb_txe_n}]
set_output_delay -clock [get_clocks usb_clk] -min 0.000000 [get_ports {usb_data[*] usb_rd_n usb_wr_n usb_oe_n}]
set_input_delay -clock [get_clocks usb_clk] -max 9.000000 [get_ports {usb_data[*] usb_rxf_n usb_txe_n}]
set_output_delay -clock [get_clocks usb_clk] -max 7.500000 [get_ports {usb_data[*] usb_rd_n usb_wr_n usb_oe_n}]
# SIWU is held inactive by the transport; it is not the FIFO transfer clock.
set_false_path -to [get_ports {usb_siwu_n}]
# USB/core CDC is constrained by the asynchronous FIFO implementation.
set_false_path -from [get_ports {trigger_in[*] uart_rx}] -to [get_pins -hier -filter {NAME =~ */sync_ff_reg[0]/D}]
# UART TX is asynchronous to the receiver's independent baud clock.
set_false_path -to [get_ports uart_tx]
# Each ODDR-forwarded DAC clock uses the shared 200 MHz MMCM output.
create_generated_clock -name dac_clk_1 -source [get_pins u_clock/u_ip/inst/mmcm_adv_inst/CLKOUT0] -divide_by 1 [get_ports {dac_clk[0]}]
# TODO: DAC 1 output min/max delay constraints are missing. Draft only.
create_generated_clock -name dac_clk_2 -source [get_pins u_clock/u_ip/inst/mmcm_adv_inst/CLKOUT0] -divide_by 1 [get_ports {dac_clk[1]}]
# TODO: DAC 2 output min/max delay constraints are missing. Draft only.
create_generated_clock -name dac_clk_3 -source [get_pins u_clock/u_ip/inst/mmcm_adv_inst/CLKOUT0] -divide_by 1 [get_ports {dac_clk[2]}]
# TODO: DAC 3 output min/max delay constraints are missing. Draft only.
create_generated_clock -name dac_clk_4 -source [get_pins u_clock/u_ip/inst/mmcm_adv_inst/CLKOUT0] -divide_by 1 [get_ports {dac_clk[3]}]
# TODO: DAC 4 output min/max delay constraints are missing. Draft only.

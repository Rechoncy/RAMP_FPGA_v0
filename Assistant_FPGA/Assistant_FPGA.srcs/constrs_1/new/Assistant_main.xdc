###trigger
create_clock -period 20.000 -name sys_clk [get_ports sys_clk]
set_property -dict {PACKAGE_PIN R4 IOSTANDARD LVCMOS33} [get_ports sys_clk]
##set_property -dict {PACKAGE_PIN U2 IOSTANDARD LVCMOS33} [get_ports sys_rst_n]
set_property -dict {PACKAGE_PIN F13 IOSTANDARD LVCMOS33} [get_ports dipole_ramp_trigger]
set_property -dict {PACKAGE_PIN F14 IOSTANDARD LVCMOS33} [get_ports fm_trigger]
set_property -dict {PACKAGE_PIN F15 IOSTANDARD LVCMOS33} [get_ports gnd0]
set_property -dict {PACKAGE_PIN F16 IOSTANDARD LVCMOS33} [get_ports gnd1]

